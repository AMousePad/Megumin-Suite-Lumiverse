{
  "version": "11.0",
  "name": "Megumin Suite",
  "identifier": "megumin_suite",
  "author": "KazumaONIISAN",
  "github": "https://github.com/Arif-salah/Megumin-Suite-Lumiverse",
  "homepage": "https://github.com/Arif-salah/Megumin-Suite-Lumiverse",
  "description": "Preset engine, World State, Chomusuke helper model, block trackers, NPC bank, story director and image generation for Lumiverse.",
  "permissions": [
    "interceptor",
    "generation",
    "chats",
    "chat_mutation",
    "characters",
    "personas",
    "image_gen",
    "images",
    "ui_panels",
    "app_manipulation",
    "cors_proxy"
  ],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "interceptorTimeoutMs": 300000,
  "minimum_lumiverse_version": "0.1.0"
}